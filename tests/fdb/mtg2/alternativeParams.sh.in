#!/usr/bin/env bash

# check the ability to handle alternative parameters in listing and retrieval
# please note: for cp it is only effective while listing
# retrieval requests pre and post MTG2 are different due to timespan=fs in the MTG2 case

set -euxo pipefail

export METKIT_MULTI_PARAM_VALUES=1

yell() { printf "$(basename "$0"): \033[0;31m!!! %s !!!\033[0m\\n" "$*" >&2; }
die() { yell "$*"; exit 1; }

fdbread="$<TARGET_FILE:fdb-read>"
fdbwrite="$<TARGET_FILE:fdb-write>"
fdblist="$<TARGET_FILE:fdb-list>"
gribcompare="$<TARGET_FILE:grib_compare>"


srcdir=@CMAKE_CURRENT_SOURCE_DIR@
bindir=@CMAKE_CURRENT_BINARY_DIR@
wdir=$bindir/alternativeParams

### cleanup and prepare test

rm -rf "$wdir"
mkdir -p "$wdir/etc/fdb"
mkdir -p "$wdir/root"

cd "$wdir"

for f in 143.grib 164.grib 228143.grib 228164.grib
do
    cp "$srcdir/$f" "$wdir"
done

for f in config.yaml schema
do
    cp "$srcdir/$f" "$wdir/etc/fdb"
done

export FDB_HOME="$wdir"
unset FDB5_CONFIG_FILE
unset FDB_CONFIG_FILE

cat > cplist <<EOF
{class=od,expver=0001,stream=oper,date=20261005,time=0000,domain=g}{type=fc,levtype=sfc}{step=24,param=143}
{class=od,expver=0001,stream=oper,date=20261006,time=0000,domain=g}{type=fc,levtype=sfc,timespan=fs}{step=24,param=228143}
EOF

cat > tcclist <<EOF
{class=od,expver=0001,stream=oper,date=20261005,time=0000,domain=g}{type=fc,levtype=sfc}{step=24,param=164}
{class=od,expver=0001,stream=oper,date=20261006,time=0000,domain=g}{type=fc,levtype=sfc,timespan=none}{step=24,param=228164}
EOF

cat > list <<EOF
{class=od,expver=0001,stream=oper,date=20261005,time=0000,domain=g}{type=fc,levtype=sfc}{step=24,param=143}
{class=od,expver=0001,stream=oper,date=20261005,time=0000,domain=g}{type=fc,levtype=sfc}{step=24,param=164}
{class=od,expver=0001,stream=oper,date=20261006,time=0000,domain=g}{type=fc,levtype=sfc,timespan=none}{step=24,param=228164}
{class=od,expver=0001,stream=oper,date=20261006,time=0000,domain=g}{type=fc,levtype=sfc,timespan=fs}{step=24,param=228143}
EOF

cat > tcc.req <<EOF
retrieve,class=od,expver=1,stream=oper,date=20261005/20261006,time=0,domain=g,type=fc,levtype=sfc,step=24,param=tcc
EOF

cat > cp.req <<EOF
retrieve,class=od,expver=1,stream=oper,date=20261005/20261006,time=0,domain=g,type=fc,levtype=sfc,step=24,param=cp
EOF

cat > cp-fs.req <<EOF
retrieve,class=od,expver=1,stream=oper,date=20261005/20261006,time=0,domain=g,type=fc,levtype=sfc,step=24,param=cp,timespan=fs
EOF

cat 143.grib 164.grib 228143.grib 228164.grib > in.grib
cat 164.grib 228164.grib > tcc.grib

$fdbwrite in.grib

$fdblist --all --minimum-keys="" --porcelain | tee out
cmp out list

$fdblist class=od,expver=0001,stream=oper --porcelain | tee out
cmp out list

$fdblist class=od,expver=0001,stream=oper,param=cp --porcelain | tee out
cmp out cplist

$fdblist class=od,expver=0001,stream=oper,param=tcc --porcelain | tee out
cmp out tcclist

$fdbread tcc.req out
$gribcompare out tcc.grib

$fdbread cp.req out
$gribcompare out 143.grib

$fdbread cp-fs.req out
$gribcompare out 228143.grib
