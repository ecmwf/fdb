#!/usr/bin/env bash

set -euxo pipefail

export PATH=@CMAKE_BINARY_DIR@/bin:$PATH
export FDB_HOME=@PROJECT_BINARY_DIR@

function post_process {
  num=0
  while read line; do [[ $line =~ ^\}, ]] && num=$((num+1)); [[ $line =~ \": ]] && echo $num $line; true; done | sort
}

srcdir=@CMAKE_CURRENT_SOURCE_DIR@
bindir=@CMAKE_CURRENT_BINARY_DIR@
cd $bindir

for f in in.grib config.yaml schema
do
  cp $srcdir/$f ./
done

######################################

cat > swh.req <<EOF
retrieve,
class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g,type=fc,levtype=sfc,step=0,timespan=none,param=140229
EOF

cat > 229.req <<EOF
retrieve,
class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g,type=fc,levtype=sfc,step=0,timespan=none,param=229
EOF

cat > swh-timespan.req <<EOF
retrieve,
class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g,type=fc,levtype=sfc,step=0,param=140229,timespan=none
EOF

cat > 229-timespan.req <<EOF
retrieve,
class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g,type=fc,levtype=sfc,step=0,param=229,timespan=none
EOF

cat > content.inst <<EOF
{ "messages" : [
  {
    "domain": "g",
    "date": 20161230,
    "time": 1800,
    "expver": 5659,
    "class": "e6",
    "type": "fc",
    "stream": "oper",
    "step": 6,
    "levtype": "sfc",
    "param": 167,
    "timespan": "none"
  },
  {
    "domain": "g",
    "date": 20161230,
    "time": 1800,
    "expver": 5659,
    "class": "e6",
    "type": "fc",
    "stream": "oper",
    "step": 12,
    "levtype": "sfc",
    "param": 167,
    "timespan": "none"
  },
  {
    "domain": "g",
    "date": 20161230,
    "time": 1800,
    "expver": 5659,
    "class": "e6",
    "type": "fc",
    "stream": "oper",
    "step": 18,
    "levtype": "sfc",
    "param": 167,
    "timespan": "none"
  }
]}
EOF

cat > content.1h <<EOF
{ "messages" : [
  {
    "domain": "g",
    "date": 20161230,
    "time": 1800,
    "expver": 5659,
    "class": "e6",
    "type": "fc",
    "stream": "oper",
    "levtype": "sfc",
    "step": 6,
    "param": 228143,
    "timespan": "1h"
  },
  {
    "domain": "g",
    "date": 20161230,
    "time": 1800,
    "expver": 5659,
    "class": "e6",
    "type": "fc",
    "stream": "oper",
    "levtype": "sfc",
    "step": 12,
    "param": 228143,
    "timespan": "1h"
  }
]}
EOF
cat > content.swh-timespan <<EOF
{ "messages" : [ 
  {
    "domain": "g",
    "date": 20260901,
    "time": "0000",
    "expver": "0001",
    "class": "od",
    "type": "fc",
    "stream": "oper",
    "step": 0,
    "levtype": "sfc",
    "param": 140229,
    "timespan": "none"
  }
]}
EOF
cat > content.229-timespan <<EOF
{ "messages" : [ 
  {
    "domain": "g",
    "date": 20260901,
    "time": "0000",
    "expver": "0001",
    "class": "od",
    "type": "fc",
    "stream": "oper",
    "step": 0,
    "levtype": "sfc",
    "param": 229,
    "timespan": "none"
  }
]}
EOF
###################################### top level

rm -rf localroot || true
mkdir localroot

export FDB5_CONFIG_FILE=config.yaml

fdb-write in.grib

cat > expected.all <<EOF
{class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc}{step=0,param=229}
{class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc,timespan=none}{timespan=none,step=0,param=140229}
{class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc,timespan=none}{timespan=none,step=0,param=229}
{class=od,expver=0001,stream=wave,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc}{step=0,param=140229}
EOF

cat > expected.none <<EOF
{class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc,timespan=none}{timespan=none,step=0,param=140229}
{class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc,timespan=none}{timespan=none,step=0,param=229}
EOF

cat > expected.empty <<EOF
{class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc}{step=0,param=229}
{class=od,expver=0001,stream=wave,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc}{step=0,param=140229}
EOF

cat > expected.229 <<EOF
{class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc}{step=0,param=229}
{class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc,timespan=none}{timespan=none,step=0,param=229}
EOF

cat > expected.wave-229 <<EOF
{class=od,expver=0001,stream=wave,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc}{step=0,param=140229}
EOF

cat > expected.140229 <<EOF
{class=od,expver=0001,stream=oper,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc,timespan=none}{timespan=none,step=0,param=140229}
{class=od,expver=0001,stream=wave,date=20260901,time=0000,domain=g}{type=fc,levtype=sfc}{step=0,param=140229}
EOF

fdb-list class=od,expver=1 --porcelain | tee all
cmp all expected.all

fdb-list class=od,expver=1,timespan=none --porcelain | tee inst
cmp inst expected.none

fdb-list class=od,expver=1,param=229 --porcelain | tee inst
cmp inst expected.229

fdb-list class=od,expver=1,stream=wave,type=fc,levtype=sfc,param=229 --porcelain | tee inst
cmp inst expected.wave-229

fdb-list class=od,expver=1,param=140229 --porcelain | tee inst
cmp inst expected.140229

# fdb-read swh.req out.grib
# grib_ls -jm out.grib           | post_process | tee out
# cat content.swh               | post_process | tee swh
# diff out swh

# fdb-read 229.req out.grib
# grib_ls -jm out.grib           | post_process | tee out
# cat content.229               | post_process | tee 229
# diff out 229

fdb-read swh-timespan.req out.grib
grib_ls -jm out.grib           | post_process | tee out
cat content.swh-timespan       | post_process | tee swh-timespan
diff out swh-timespan

fdb-read 229-timespan.req out.grib
grib_ls -jm out.grib           | post_process | tee out
cat content.229-timespan       | post_process | tee 229-timespan
diff out 229-timespan
