[ class=od, expver, stream=oper, date, time, domain?
    # post-MTG2 - timespan needs to be present and we enforce strict param matching
    [ type, levtype, timespan?Defined
        [ timespan?none, step, levelist?, param:ParamID, frequency?, direction? ]]

    # pre-MTG2 (50r1) - no timespan (but we accept timespan=none in the requests)
    [ type, levtype
        [ timespan?none, step, levelist?, param:Param ]]
]

[ class=od, expver, stream=wave, date, time, domain?
    # pre-MTG2 (50r1) - no timespan (but we accept timespan=none in the requests)
    [ type, levtype, timespan?none
        [ step, param:Param, frequency?, direction? ]]
]