[ class=ng, activity, experiment, generation, model, realization, expver, stream=clte/wave, date: Year
    [ date: Month, resolution, type, levtype
        [ date: Date, time, levelist?, param, frequency?, direction? ]]
]
# clmn
[ class=ng, activity, experiment, generation, model, realization, expver, stream=clmn, year
    [ month, resolution, type, levtype
        [ levelist?, param ]]
]
########################################################
