[ class=rd, expver, stream=oper/wave/dcda/dcwv, date, time, domain?
        [ type, levtype
                [ step, levelist?, param, frequency?, direction? ]
  ]
]
# lwda/lwwv
[ class=rd, expver, stream=lwda/lwwv, date, time, domain?
        [ type, levtype, anoffset
                [ step, levelist?, param, frequency?, direction? ]
  ]
]
