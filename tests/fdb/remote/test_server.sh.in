#!/usr/bin/env bash

# --- Documentation
# This script is used to start a test server for the remote fdb tests

if [[ $# -lt 4 ]]; then
    echo "Usage: $0 <test_directory> <client_config> <catalogue_config> <store_config>" >&2
    exit 1
fi

set -ux

#  --- Variables
testdir=$1
client_config="$testdir/$2"
catalogue_config="$testdir/$3"
store_config="$testdir/$4"
catalogue_rootdir=$testdir/catalogue_root
store_rootdir=$testdir/store_root
server_pidfile=$testdir/servers.pid

fdbwrite="$<TARGET_FILE:fdb-write>"
server="$<TARGET_FILE:fdb-server>"
# Optional 5th arg: path to the client test binary to run. Defaults to fdb_test_remote_api_bin
# for backward compatibility with callers that only pass 4 args.
test="${5:-$<TARGET_FILE:fdb_test_remote_api_bin>}"

# If test exceeds this time, the servers will be killed. Required to ensure servers are eventually killed when ctest is SIGKILL'd
SERVER_LIFETIME=600
server_group_pids=()
server_pids=()

# --- Cleanup and setup
cleanup() {
  local server_pid
  local server_pgid

  if ((${#server_group_pids[@]} == 0)); then
    for server_pid in "${server_pids[@]}"; do
      server_pgid=$(ps -o pgid= -p "$server_pid" 2>/dev/null | tr -d '[:space:]')
      [[ "$server_pgid" =~ ^[0-9]+$ ]] && server_group_pids+=("$server_pgid")
    done
  fi

  for server_pgid in "${server_group_pids[@]}"; do
    kill -TERM -- "-$server_pgid" 2>/dev/null || true
  done
  if ((${#server_group_pids[@]})); then
    sleep 0.2
    for server_pgid in "${server_group_pids[@]}"; do
      kill -KILL -- "-$server_pgid" 2>/dev/null || true
    done
  fi

    if [[ -f $server_pidfile ]]; then
    while read -r _ _ server_pid; do
      kill -TERM "$server_pid" 2>/dev/null || true
            sleep 0.2
      kill -KILL "$server_pid" 2>/dev/null || true
        done < $server_pidfile
        rm $server_pidfile
    fi

    rm -rf $catalogue_rootdir
    rm -rf $store_rootdir
}

run_server() {
  # Usage: run_server LABEL CONFIG SERVER_CMD...
  # - Starts a catalogue/store server
  # - Prepends [LABEL] to each line of output
  # - Appends the server's PID to the pidfile for cleanup.
  local label="$1"; shift
  local config="$1"; shift
  local port
  port=$(awk '/^[[:space:]]*serverPort:/{print $2; exit}' "$config")
  [[ "$port" =~ ^[0-9]+$ ]] || { echo "Unable to determine server port from $config" >&2; exit 1; }

  setsid env FDB5_CONFIG_FILE="$config" FDB5_SUB_TOCS=1 FDB_DEBUG=1 FDB_WIPE_SECRET="123" \
      timeout "$SERVER_LIFETIME" "$@" > >(
    awk -v label="$label" '
        {
          print "[" label "] " $0
          fflush()
        }
      '
  ) 2>&1 &
  local server_pid=$!
  server_pids+=("$server_pid")
  printf '%s %s %s\n' "$label" "$port" "$server_pid" >> "$server_pidfile"
}

port_is_listening() {
    local port_hex
    local proc_files=(/proc/net/tcp)
    [[ -r /proc/net/tcp6 ]] && proc_files+=(/proc/net/tcp6)
    [[ -r /proc/net/tcp ]] || return 0

    printf -v port_hex '%04X' "$1"
    awk -v port="$port_hex" '$4 == "0A" { split($2, address, ":"); if (toupper(address[2]) == port) found=1 }
                             END { exit !found }' "${proc_files[@]}"
}

wait_for_servers() {
    local label
    local port
    local server_pid
    local server_pgid
    local server_info
    local deadline=$((SECONDS + 10))

    while ((SECONDS < deadline)); do
        local ready=true
        for label in "$@"; do
          server_info=$(awk -v label="$label" '$1 == label {print $2, $3; exit}' "$server_pidfile" 2>/dev/null || true)
            if [[ -z "$server_info" ]]; then
                ready=false
                break
            fi
            read -r port server_pid <<< "$server_info"
            if ! kill -0 "$server_pid" 2>/dev/null; then
                echo "$label fdb-server exited before becoming ready" >&2
                exit 1
            fi
            if ! port_is_listening "$port"; then
                ready=false
                break
            fi
        done

        if [[ "$ready" == true ]]; then
            server_group_pids=()
            for label in "$@"; do
              server_pid=$(awk -v label="$label" '$1 == label {print $3; exit}' "$server_pidfile")
                server_pgid=$(ps -o pgid= -p "$server_pid" | tr -d '[:space:]')
                [[ "$server_pgid" =~ ^[0-9]+$ ]] || { echo "Unable to determine process group for $label" >&2; exit 1; }
                server_group_pids+=("$server_pgid")
            done
            return
        fi
        sleep 0.1
    done

    echo "Timed out waiting for remote test servers: $*" >&2
    exit 1
}

trap cleanup EXIT
trap 'exit 1' INT TERM

#  -- Start fresh
cleanup
mkdir $catalogue_rootdir $store_rootdir

# --- Start the servers in the background.

run_server "CATALOGUE" "$catalogue_config" "$server"
run_server "STORE" "$store_config" "$server"

wait_for_servers CATALOGUE STORE

# --- Run the client test
FDB5_CONFIG_FILE=$client_config $test
exit $?
