---
type: catalogue
serverPort: 10000
serverThreaded: true
stores:
- default: "localhost:10001"
schema: @CMAKE_CURRENT_SOURCE_DIR@/schema
spaces:
- handler: Default
  roots:
    - path: @CMAKE_CURRENT_BINARY_DIR@/catalogue_root
tracing:
  enabled: @TRACING_SERVER@
  sampler: parentbased_always_on
  exporter: log
  path: @CMAKE_CURRENT_BINARY_DIR@/tracing_@TRACING_VARIANT@_catalogue.jsonl
