#!/usr/bin/env bash

set -euxo pipefail

yell() {
  printf "$(basename "$0"): \033[0;31m!!! %s !!!\033[0m\n" "$*" >&2
}

die() {
  yell "$*"
  exit 1
}

command_exists() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

line_count() {
  [[ $# -eq 1 ]] || die "line_count requires 1 argument; expected line count"
  val=$(wc -l < out) && val=$((val + 0))
  [[ $val -eq $1 ]] || die "Incorrect count => [$val != $1]"
}

########################################################################################################################

export PATH=@CMAKE_BINARY_DIR@/bin:$PATH
export FDB_HOME=@PROJECT_BINARY_DIR@

# Validate required commands
command_exists grib_set
command_exists grib_ls
command_exists fdb-fam
command_exists fdb-write
command_exists fdb-list

test_name=fam_ranges
src_data="../../../od.oper.grib"
src_dir=@CMAKE_CURRENT_SOURCE_DIR@
bin_dir=@CMAKE_CURRENT_BINARY_DIR@

# When ECKIT_FAM_TEST_ENDPOINT is set (real OpenFAM), use it verbatim.
# Otherwise (mock), embed PID in hostname so each test gets its own shm segment.
fam_endpoint="${ECKIT_FAM_TEST_ENDPOINT:-localhost_$$:8880}"
test_region="fdb_list_fam_ranges_$$"
fam_uri="fam://${fam_endpoint}/${test_region}"

########################################################################################################################

echo "running test '$test_name' on $(hostname)"

cd "$bin_dir" || die "Failed to change to binary directory: $bin_dir"

rm -rf "$test_name"
mkdir -p "$test_name/localroot" || die "Failed to create test directory: $test_name/localroot"

cd "$test_name" || die "Failed to change to test directory: $test_name"

# Repack source data to a tiny grid to reduce FAM memory footprint (76 MB → ~3 KB)
grib_set -s packingType=grid_simple,gridType=regular_ll,Ni=10,Nj=10,iDirectionIncrementInDegrees=36,jDirectionIncrementInDegrees=18,bitsPerValue=8 "$src_data" od.oper.small.grib
src_data="od.oper.small.grib"

# Create the FAM region (4 MB — repacked data is ~3 KB per file, 3 writes)
fdb-fam --endpoint="$fam_endpoint" --create --size=33554432 --perm=0640 "/$test_region"

cleanup() {
    echo "cleanup"
    fdb-fam --endpoint="$fam_endpoint" --delete "/$test_region" 2>/dev/null || true
    rm -rf "$bin_dir/$test_name" 2>/dev/null || true
    # Remove per-process mock shm segment (no-op when using real OpenFAM)
    [[ -z "${ECKIT_FAM_TEST_ENDPOINT:-}" ]] && rm -f "/dev/shm/eckit_fam_mock_localhost_$$" 2>/dev/null || true
}
trap cleanup EXIT

echo "Setup validation:"
[[ -d "$bin_dir" ]] || die "Binary directory not found: $bin_dir"
[[ -n "$FDB_HOME" ]] || die "FDB_HOME not set"
[[ -d "$FDB_HOME" ]] || die "FDB_HOME directory not found: $FDB_HOME"

schema_src="$FDB_HOME/etc/fdb/schema"

cat > local.yaml <<EOF
---
type: local
engine: fam
schema: ${schema_src}
store: fam
catalogue: fam
spaces:
- handler: Default
  roots:
  - path: $(pwd)/localroot
fam_roots:
- uri: ${fam_uri}
  writable: true
  visit: true
EOF

export FDB5_CONFIG_FILE="$(pwd)/local.yaml"

work_dir=$(pwd)
echo "Working directory: $work_dir"

########################################################################################################################

# Ensure that we can wipe specified databases with ranges in the requests
# --> Ensures the MARS requests are working correctly

grib_set -s class=rd,expver=xxxx "$src_data" data.xxxx.d1.grib
grib_set -s class=rd,expver=xxxx,date=20240912 "$src_data" data.xxxx.d2.grib
grib_set -s class=rd,expver=xxxx,date=20241001 "$src_data" data.xxxx.d3.grib
grib_ls -m data.xxxx.d1.grib

fdb-write data.xxxx.d1.grib
fdb-write data.xxxx.d2.grib
fdb-write data.xxxx.d3.grib

fdb-list --all --minimum-keys="" --porcelain --full | tee out
line_count 72

fdb-list class=rd,expver=xxxx --porcelain | tee out
line_count 72

fdb-list class=rd,expver=xxxx,date=20240911 --porcelain | tee out
line_count 24

fdb-list class=rd,expver=xxxx,date=20240911/20240912 --porcelain | tee out
line_count 48

fdb-list class=rd,expver=xxxx,date=20240911/20240912/20241001 --porcelain | tee out
line_count 72

fdb-list class=rd,expver=xxxx,date=20240911/20240912/20241001/20060101,stream=oper,type=an,levtype=pl,param=60 --porcelain | tee out
line_count 0

fdb-list class=rd,expver=xxxx,date=20240911/20240912/20241001,stream=oper,type=an,levtype=pl,param=155 --porcelain | tee out
line_count 36

fdb-list class=rd,expver=xxxx,date=20240911/20240912/20241001,stream=oper,type=an,levtype=pl,param=60/155 --porcelain | tee out
line_count 36

fdb-list class=rd,expver=xxxx,date=20240911/20240912/20241001,stream=oper,type=an,levtype=pl,param=60/155/138 --porcelain | tee out
line_count 72

fdb-list class=rd,expver=xxxx,date=20240911/20240912/20241001,stream=oper,type=an,levtype=pl,param=60/155/138,levelist=300/400/500/700/850/1000 --porcelain | tee out
line_count 72

fdb-list class=rd,expver=xxxx,date=20240911/20240912/20241001,stream=oper,type=an,levtype=pl,param=60/155/138,levelist=300/123/1000 --porcelain | tee out
line_count 24
