#!/usr/bin/env bash

# Per-index visitation of a toc database runs across several threads (FDB-743), and fdb-stats opts
# in via StatsReportVisitor::supportsConcurrentIndexVisitation(). Statistics are accumulated per
# index and merged in catalogue order in catalogueComplete(), so the thread count must not be
# observable in the output.
#
# The duplicates in the fixture are the point: de-duplication keeps whichever copy of a field is
# merged first, and everything after it is charged to its own index as a duplicate. If accumulator
# order were not pinned to index order, the per-index breakdown under --details would shift even
# though the totals stayed put.

set -euxo pipefail

yell() { printf "$(basename "$0"): \033[0;31m!!! %s !!!\033[0m\\n" "$*" >&2; }
die() { yell "$*"; exit 1; }

########################################################################################################################

export PATH=@CMAKE_BINARY_DIR@/bin:${ECCODES_BINARY_PATH}:$PATH
export FDB_HOME=@PROJECT_BINARY_DIR@

# Config::readIndexThreads() reads this through a static eckit::Resource that takes priority over
# the user config, which is where --threads lands. Left set, --threads would be ignored and every
# comparison below would be 8 against 8.
unset FDB_READ_INDEX_THREADS || true

test_name=stats_concurrent
srcdir=@CMAKE_CURRENT_SOURCE_DIR@
bindir=@CMAKE_CURRENT_BINARY_DIR@

########################################################################################################################

echo "running test '$test_name' on $(hostname)"

cd $bindir

rm -rf $test_name
mkdir -p $test_name/localroot
cd $test_name

for f in local.yaml x.grib; do
  cp $srcdir/$f ./
done

export FDB5_CONFIG_FILE=local.yaml

########################################################################################################################
# Fixture: several indexes per database, every field written more than once, over two databases.
#
# Each fdb-write session appends a fresh index record, so repeating the passes leaves many indexes
# holding the same fields. The expver=yyyy copy gives a second database, so the --details listing
# and the aggregated summary are both exercised.

for step in 6 9 12; do
  grib_set -s step=$step x.grib "x.$step.grib"
  grib_set -s expver=yyyy "x.$step.grib" "y.$step.grib"
done

for pass in 1 2 3; do
  for step in 6 9 12; do
    fdb-write "x.$step.grib"
    fdb-write "y.$step.grib"
  done
done

########################################################################################################################
# Confirm the fixture really is multi-index, else every comparison below passes trivially.
# n.b. the eckit debug channel writes to stdout, so this run is kept away from the comparisons.

FDB_DEBUG=1 fdb-list --all --minimum-keys="" --porcelain > indexes.debug 2>&1

nindexes=$(sed -nE 's/.*Visiting ([0-9]+) indexes.*/\1/p' indexes.debug | sort -rn | sed -n 1p)
[[ -n "${nindexes:-}" ]] || die "could not determine the index count"
[[ $nindexes -ge 4 ]] || die "expected several indexes per database, got [$nindexes]"

echo "fixture: $nindexes indexes in the largest database"

########################################################################################################################
# --threads=1 against --threads=8, byte for byte.

run_variant() {
  local name="$1"; shift

  fdb-stats --all --minimum-keys= --threads=1 "$@" > "$name.threads1"
  [[ -s "$name.threads1" ]] || die "fdb-stats $* produced no output; the comparison is meaningless"

  # Repeated: a lost ordering guarantee only shows up on some interleavings.
  for attempt in 1 2 3; do
    fdb-stats --all --minimum-keys= --threads=8 "$@" > "$name.threads8"
    cmp "$name.threads1" "$name.threads8" \
      || die "fdb-stats $* differs between --threads=1 and --threads=8 (attempt $attempt)"
  done

  echo "fdb-stats $*: identical across thread counts"
}

run_variant plain
run_variant details --details
run_variant json    --json
run_variant jsondet --json --details

########################################################################################################################
# Cross-check the totals against an independent oracle, so that a counting change that happens to
# affect both thread counts equally cannot slip through a pure determinism test.
#
#   fields    - every datum visited, duplicates included  == fdb-list --full
#   reachable - the de-duplicated entries                 == fdb-list

listed_all=$(fdb-list --all --minimum-keys= --full --porcelain | wc -l | tr -d ' ')
listed_dedup=$(fdb-list --all --minimum-keys= --porcelain | wc -l | tr -d ' ')

stats_fields=$(sed -nE 's/.*"fields":([0-9]+).*/\1/p' json.threads1)
stats_reachable=$(sed -nE 's/.*"reachable":([0-9]+).*/\1/p' json.threads1)

[[ "$stats_fields" == "$listed_all" ]] \
  || die "stats reports $stats_fields fields, fdb-list --full reports $listed_all"
[[ "$stats_reachable" == "$listed_dedup" ]] \
  || die "stats reports $stats_reachable reachable, fdb-list reports $listed_dedup"

echo "totals agree with fdb-list: $stats_fields fields, $stats_reachable reachable"

echo "$test_name: OK"
