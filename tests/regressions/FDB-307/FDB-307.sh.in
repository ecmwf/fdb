#!/usr/bin/env bash

set -euxo pipefail

fdbread="$<TARGET_FILE:fdb-read>"
fdbwrite="$<TARGET_FILE:fdb-write>"
fdblist="$<TARGET_FILE:fdb-list>"
fdboverlay="$<TARGET_FILE:fdb-overlay>"
fdbpurge="$<TARGET_FILE:fdb-purge>"
fdbwipe="$<TARGET_FILE:fdb-wipe>"
fdbmove="$<TARGET_FILE:fdb-move>"

gribls="$<TARGET_FILE:grib_ls>"
gribset="$<TARGET_FILE:grib_set>"

function post_process {
  num=0
  while read line; do [[ $line =~ ^\}, ]] && num=$((num+1)); [[ $line =~ \": ]] && echo $num $line; true; done | sort
}

srcdir=@CMAKE_CURRENT_SOURCE_DIR@
bindir=@CMAKE_CURRENT_BINARY_DIR@

export FDB_HOME=$bindir

export FDB_DEBUG=0
export ECKIT_DEBUG=0

# remove me when eckit::TaskInfo races are fixed
tsan_suppressions=$bindir/tsan_suppressions.txt
export TSAN_OPTIONS="${TSAN_OPTIONS:-} suppressions=$tsan_suppressions"

### cleanup and prepare test

rm -f out.*
rm -rf ${bindir}/root*
mkdir -p ${bindir}/root
mkdir -p ${bindir}/root2

for f in config.yaml schema x.grib
do
    cp $srcdir/$f $bindir
done

export FDB5_CONFIG_FILE=config.yaml

$gribset -s expver=xxxy x.grib y.grib
$gribset -s step=6 x.grib x6.grib

cat > list <<EOF
{class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g}{type=fc,levtype=sfc}{step=12,param=166}
{class=rd,expver=xxxy,stream=oper,date=20201102,time=0000,domain=g}{type=fc,levtype=sfc}{step=12,param=166}
EOF

cat > listX <<EOF
{class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g}{type=fc,levtype=sfc}{step=12,param=166}
EOF

cat > listX6 <<EOF
{class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g}{type=fc,levtype=sfc}{step=6,param=166}
{class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g}{type=fc,levtype=sfc}{step=12,param=166}
EOF

cat > listZ6 <<EOF
{class=rd,expver=xxxz,stream=oper,date=20201102,time=0000,domain=g}{type=fc,levtype=sfc}{step=6,param=166}
{class=rd,expver=xxxz,stream=oper,date=20201102,time=0000,domain=g}{type=fc,levtype=sfc}{step=12,param=166}
EOF

cat > listY <<EOF
{class=rd,expver=xxxy,stream=oper,date=20201102,time=0000,domain=g}{type=fc,levtype=sfc}{step=12,param=166}
EOF

cat > none <<EOF
EOF

$fdbwrite x.grib
$fdbwrite y.grib

$fdblist --all --minimum-keys="" --porcelain | tee out
cmp out list

$fdbwrite x.grib

$fdblist --all --minimum-keys="" --porcelain | tee out
cmp out list

$fdblist class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g --porcelain | tee out
cmp out listX

$fdbwrite x6.grib

$fdblist class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g --porcelain | tee out
cmp out listX6

$fdblist class=rd,expver=xxxy,stream=oper,date=20201102,time=0000,domain=g --porcelain | tee out
cmp out listY

$fdbwipe class=rd,expver=xxxy,stream=oper,date=20201102,time=0000,domain=g --doit --unsafe-wipe-all

$fdblist class=rd,expver=xxxy,stream=oper,date=20201102,time=0000,domain=g --porcelain | tee out
cmp out none

$fdbpurge class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g --doit

$fdblist class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g --porcelain | tee out
cmp out listX6

$fdboverlay --variable-keys=expver class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g class=rd,expver=xxxz,stream=oper,date=20201102,time=0000,domain=g

### The access timestamps travel with the data: fdb-move copies them like any other file, and the
### copy reproduces the source's mode and mtime. The mtime is the entire content of these files, so
### a move that restamped them would make every moved database look freshly accessed.

mode_of() { stat -f %Lp "$1" 2>/dev/null || stat -c %a "$1"; }
mtime_of() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1"; }

src_db=${bindir}/root/rd:xxxz:oper:20201102:0000:g
dest_db=${bindir}/root2/rd:xxxz:oper:20201102:0000:g

[[ -e $src_db/read.timestamp ]] || { echo "No read timestamp to move"; exit 1; }
[[ -e $src_db/write.timestamp ]] || { echo "No write timestamp to move"; exit 1; }

# Backdate them, so that a restamped destination would be obvious.
touch -t 202001010000 $src_db/read.timestamp $src_db/write.timestamp

read_mode=$(mode_of $src_db/read.timestamp)
write_mode=$(mode_of $src_db/write.timestamp)
read_mtime=$(mtime_of $src_db/read.timestamp)
write_mtime=$(mtime_of $src_db/write.timestamp)

$fdbmove --threads=2 --dest=./root2 class=rd,expver=xxxz,stream=oper,date=20201102,time=0000,domain=g

[[ ! -d $src_db ]] || { echo "Source database $src_db was not removed"; exit 1; }

[[ $(mode_of $dest_db/read.timestamp) == $read_mode ]] || { echo "read.timestamp lost its mode"; exit 1; }
[[ $(mode_of $dest_db/write.timestamp) == $write_mode ]] || { echo "write.timestamp lost its mode"; exit 1; }
[[ $(mtime_of $dest_db/read.timestamp) -eq $read_mtime ]] || { echo "read.timestamp lost its mtime"; exit 1; }
[[ $(mtime_of $dest_db/write.timestamp) -eq $write_mtime ]] || { echo "write.timestamp lost its mtime"; exit 1; }

$fdblist class=rd,expver=xxxz,stream=oper,date=20201102,time=0000,domain=g --porcelain | tee out
cmp out listZ6

$fdblist class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g --porcelain | tee out
cmp out listX6

$fdbmove --threads=2 --dest=./root2 class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g

$fdblist class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g --porcelain | tee out
cmp out listX6

$fdbwrite x6.grib
$fdbwrite y.grib

$fdbpurge class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g --doit

$fdblist class=rd,expver=xxxx,stream=oper,date=20201102,time=0000,domain=g --porcelain | tee out
cmp out listX6

$fdblist class=rd,expver=xxxy,stream=oper,date=20201102,time=0000,domain=g --porcelain | tee out
cmp out listY
